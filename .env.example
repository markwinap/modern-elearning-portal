# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Better Auth
# Secret used by Better Auth
BETTER_AUTH_SECRET=""

# Better Auth GitHub OAuth
BETTER_AUTH_GITHUB_CLIENT_ID=""
BETTER_AUTH_GITHUB_CLIENT_SECRET=""

# Drizzle
DATABASE_URL="postgresql://postgres:password@localhost:5432/modern-elearning-portal"

# Tavily MCP
TAVILY_API_KEY=""

# Open WebUI (OpenCode provider + openwebui MCP server)
# Referenced by .opencode/opencode.json as {env:OPENWEBUI_API_KEY}.
# NOTE: a previous token was committed to .opencode/opencode.json — rotate it in Open WebUI.
OPENWEBUI_API_KEY=""

# Playwright e2e tests
# Credentials for a teacher account used by `e2e/auth.setup.ts` to sign in
# once and reuse the session across authenticated e2e tests. Not validated
# by src/env.js — only read directly by Playwright config/tests.
E2E_TEACHER_EMAIL=""
E2E_TEACHER_PASSWORD=""
E2E_STUDENT_EMAIL=""
E2E_STUDENT_PASSWORD=""
# Resend Email API
RESEND_API_KEY=""
EMAIL_FROM_ADDRESS="noreply@modern-elearning-portal.local"
EMAIL_FROM_NAME="Modern E-Learning Portal"

# Cron / background jobs
# A secret used to authorize cron requests such as the digest sender.
CRON_SECRET=""